@page "/hosts/add"
@using OrchestrationPlatform.WebUI.Enums
@using OrchestrationPlatform.WebUI.Models.Hosts
@using OrchestrationPlatform.WebUI.Services.Hosts
@rendermode @(new InteractiveServerRenderMode(false))
@inject NavigationManager NavManager
@inject IHostHttpService HostService

<PageTitle>Add New Host - Orchestra</PageTitle>

<div class="page-header mb-5">
    <h1 class="page-title">Deploy New Node</h1>
    <p class="page-subtitle">Configure connection details for your new target machine</p>
</div>

<div class="custom-card shadow-sm border-0 position-relative" style="max-width: 900px; border-radius: 16px; overflow: hidden;">
    <div style="height: 6px; background: linear-gradient(90deg, var(--primary-purple), #a855f7); width: 100%; position: absolute; top: 0; left: 0;"></div>

    <div class="p-4 p-md-5">
        <h4 class="mb-4 d-flex align-items-center" style="color: var(--text-main); font-weight: 700;">
            <svg class="me-2 text-primary" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Host Configuration
        </h4>

        @if (!string.IsNullOrEmpty(_pageError))
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                @_pageError
                <button type="button" class="btn-close" @onclick="() => _pageError = null"></button>
            </div>
        }

        <EditForm Model="@_formModel" OnValidSubmit="HandleValidSubmit" FormName="CreateHostForm">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="modern-label">
                    <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                    Host Identifier
                </label>
                <InputText @bind-Value="_formModel.Name" class="form-control glass-input" placeholder="e.g., Prod-Web-Server" autocomplete="off" />
                <ValidationMessage For="@(() => _formModel.Name)" class="text-danger mt-1 small fw-bold" />
            </div>

            <div class="row">
                <div class="col-md-7 mb-4">
                    <label class="modern-label">
                        <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                        IPv4 Address
                    </label>
                    <InputText @bind-Value="_formModel.IpAddress" class="form-control glass-input" placeholder="192.168.18.139" autocomplete="off" />
                    <ValidationMessage For="@(() => _formModel.IpAddress)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="col-md-5 mb-4">
                    <label class="modern-label">
                        <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        SSH User
                    </label>
                    <InputText @bind-Value="_formModel.Username" class="form-control glass-input" placeholder="deploy-agent" autocomplete="off" />
                    <ValidationMessage For="@(() => _formModel.Username)" class="text-danger mt-1 small fw-bold" />
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-md-3 mb-4">
                    <label class="modern-label">SSH Port</label>
                    <InputNumber @bind-Value="_formModel.SshPort" class="form-control glass-input" />
                    <ValidationMessage For="@(() => _formModel.SshPort)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="col-md-3 mb-4">
                    <label class="modern-label">OS Family</label>
                    <InputSelect @bind-Value="_formModel.OperatingSystemFamily" class="form-select glass-input">
                        <option value="">-- Select --</option>
                        @foreach (var os in Enum.GetValues<OperatingSystemFamily>())
                        {
                            <option value="@os">@os.ToString()</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formModel.OperatingSystemFamily)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="col-md-3 mb-4">
                    <label class="modern-label">OS Version</label>
                    <InputText @bind-Value="_formModel.OperatingSystemVersion" class="form-control glass-input" placeholder="e.g., 22.04" />
                    <ValidationMessage For="@(() => _formModel.OperatingSystemVersion)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="col-md-3 mb-4">
                    <label class="modern-label">Architecture</label>
                    <InputSelect @bind-Value="_formModel.Architecture" class="form-select glass-input">
                        <option value="">-- Select --</option>
                        @foreach (var arch in Enum.GetValues<CpuArchitecture>())
                        {
                            <option value="@arch">@arch.ToString()</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formModel.Architecture)" class="text-danger mt-1 small fw-bold" />
                </div>
            </div>

            <div class="alert mt-2 mb-5 d-flex" style="background-color: rgba(99, 102, 241, 0.05); border: 1px dashed rgba(99, 102, 241, 0.3); border-radius: 10px; color: var(--text-muted); font-size: 0.9rem;">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-3 flex-shrink-0" style="color: var(--primary-purple);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <div>
                    Make sure the public SSH key is added to the target machine's <code style="color: var(--primary-purple);">authorized_keys</code> before deploying packages.
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center mt-4">
                <a href="/hosts" class="btn btn-link text-muted me-4 text-decoration-none fw-bold">Cancel</a>

                <button type="submit" class="btn text-white px-4 py-2 d-flex align-items-center" style="background-color: var(--primary-purple); border-radius: 10px; font-weight: 600; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); transition: all 0.3s;" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Connecting...</span>
                    }
                    else
                    {
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        <span>Register Node</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .glass-input {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 0.85rem 1.25rem;
        border-radius: 10px;
        font-size: 0.95rem;
        color: var(--text-main);
        transition: all 0.2s ease-in-out;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
    }

        .glass-input:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

    .modern-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        font-weight: 700;
    }
</style>

@code {
    private readonly CreateHostFormModel _formModel = new();
    private bool _isSubmitting;
    private string? _pageError;

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        _pageError = null;
        StateHasChanged();

        try
        {
            await HostService.CreateHostAsync(_formModel);
            NavManager.NavigateTo("/hosts");
        }
        catch (Exception ex)
        {
            _pageError = "Failed to create host: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}