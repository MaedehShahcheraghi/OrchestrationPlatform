@page "/hosts"
@using OrchestrationPlatform.WebUI.DTOs.Hosts
@using OrchestrationPlatform.WebUI.Services.Hosts
@rendermode @(new InteractiveServerRenderMode(false))
@inject IHostHttpService HostService
@inject IJSRuntime JS

<PageTitle>Hosts & Nodes - Orchestra</PageTitle>

<div class="d-flex justify-content-between align-items-center page-header mb-4">
    <div>
        <h1 class="page-title">Managed Hosts</h1>
        <p class="page-subtitle">View and manage your Linux infrastructure nodes</p>
    </div>
    <a href="/hosts/add" class="btn text-white d-flex align-items-center" style="background-color: var(--primary-purple); border-radius: 8px; padding: 10px 20px; font-weight: 600; text-decoration: none;">
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        Add New Host
    </a>
</div>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" style="border-radius: 12px;">
        @_pageError
        <button type="button" class="btn-close" @onclick="() => _pageError = null"></button>
    </div>
}

<div class="custom-card shadow-sm" style="border-radius: 16px; padding: 24px;">
    @if (_isLoading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary mb-3" role="status" style="color: var(--primary-purple) !important; width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span class="text-muted fw-bold">Fetching hosts data from server...</span>
        </div>
    }
    else if (!_hosts.Any())
    {
        <div class="text-center py-5 text-muted">
            <svg width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="mb-3 opacity-50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
            <h4 class="fw-bold" style="color: var(--text-main);">No hosts found</h4>
            <p>You haven't added any Linux targets yet. Click "Add New Host" to get started.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <th>Host Name</th>
                        <th>IP Address</th>
                        <th>SSH Username</th>
                        <th>Status</th>
                        <th>Added Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var host in _hosts)
                    {
                        <tr>
                            <td class="fw-bold d-flex align-items-center" style="color: var(--text-main);">
                                <div class="me-3 p-2 rounded" style="background-color: rgba(99, 102, 241, 0.1); color: var(--primary-purple);">
                                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
                                </div>
                                @host.Name
                            </td>
                            <td style="font-family: 'Consolas', monospace; font-size: 0.95rem;">@host.IpAddress</td>
                            <td class="text-muted">@host.Username</td>
                            <td>
                                @if (host.IsActive)
                                {
                                    <span class="badge rounded-pill" style="background-color: rgba(16, 185, 129, 0.15); color: var(--success-green); padding: 6px 12px;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill" style="background-color: rgba(100, 116, 139, 0.15); color: var(--text-muted); padding: 6px 12px;">Inactive</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size: 0.9rem;">@host.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a href="/hosts/edit/@host.Id" class="btn btn-sm btn-light border me-2 d-inline-flex align-items-center" style="font-weight: 600; color: var(--primary-purple);">
                                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                    Edit
                                </a>
                                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" @onclick="() => HandleDeleteHost(host.Id, host.Name)">
                                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private List<HostDto> _hosts = new();
    private string? _pageError;

    protected override async Task OnInitializedAsync()
    {
        await LoadHostsAsync();
    }

    private async Task LoadHostsAsync()
    {
        _isLoading = true;
        _pageError = null;
        StateHasChanged();

        try
        {
            _hosts = await HostService.GetAllHostsAsync();
        }
        catch (Exception ex)
        {
            _pageError = "Failed to load hosts: " + ex.Message;
            _hosts = new List<HostDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteHost(Guid id, string hostName)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the host '{hostName}'?");
        if (confirmed)
        {
            try
            {
                await HostService.DeleteHostAsync(id);
                await LoadHostsAsync(); 
            }
            catch (Exception ex)
            {
                _pageError = "Failed to delete host: " + ex.Message;
            }
        }
    }
}