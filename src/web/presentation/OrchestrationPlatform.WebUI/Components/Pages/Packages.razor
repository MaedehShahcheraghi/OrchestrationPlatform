@page "/packages"
@using OrchestrationPlatform.WebUI.DTOs.Packages
@using OrchestrationPlatform.WebUI.Enums
@using OrchestrationPlatform.WebUI.Models.Packages
@using OrchestrationPlatform.WebUI.Services.Packages
@rendermode @(new InteractiveServerRenderMode(false))
@inject IPackageHttpService PackageService

<PageTitle>Software Packages - Orchestra</PageTitle>

<div class="page-header mb-4">
    <h1 class="page-title">Software Catalog</h1>
    <p class="page-subtitle">Manage your software packages and upload new versions (.deb artifacts)</p>
</div>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" style="border-radius: 12px;">
        @_pageError
        <button type="button" class="btn-close" @onclick="() => _pageError = null"></button>
    </div>
}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="custom-card shadow-sm h-100 p-0" style="border-radius: 16px; overflow: hidden;">
            <div class="p-3 d-flex justify-content-between align-items-center" style="background-color: #f8fafc; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold d-flex align-items-center" style="color: var(--text-main);">
                    <svg class="me-2 text-primary" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    Packages
                </h6>
                <button class="btn btn-sm text-white d-flex align-items-center" @onclick="OpenNewPackageModal" style="background-color: var(--primary-purple); border-radius: 6px;">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    New
                </button>
            </div>

            @if (_isLoadingPackages)
            {
                <div class="text-center p-4">
                    <div class="spinner-border spinner-border-sm text-primary" style="color: var(--primary-purple) !important;"></div>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var pkg in _packages)
                    {
                        <div class="list-group-item list-group-item-action package-list-item d-flex justify-content-between align-items-center @(pkg.Id == _selectedPackageId ? "active-pkg" : "")">
                            <div class="w-100 d-flex align-items-center" @onclick="() => SelectPackage(pkg)" style="cursor:pointer;">
                                <svg class="me-2 text-secondary" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                                <span class="fw-bold">@pkg.Name</span>
                            </div>
                            <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => HandleDeletePackage(pkg.Id)" title="Delete Package">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                        </div>
                    }
                    @if (!_packages.Any())
                    {
                        <div class="text-center p-4 text-muted small">No packages found. Create one to get started.</div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <div class="custom-card shadow-sm h-100" style="border-radius: 16px; min-height: 400px;">
            @if (_selectedPackageId == null)
            {
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted opacity-50">
                    <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="mb-3"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z" /></svg>
                    <h4>Select a package</h4>
                    <p>Click on a software package from the left to view its versions.</p>
                </div>
            }
            else if (_isLoadingVersions)
            {
                <div class="d-flex justify-content-center align-items-center h-100">
                    <div class="spinner-border text-primary" style="color: var(--primary-purple) !important;"></div>
                </div>
            }
            else
            {
                var selectedPkg = _packages.First(p => p.Id == _selectedPackageId);

                <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px dashed var(--border-color);">
                    <div>
                        <h3 class="mb-1 fw-bold" style="color: var(--text-main);">@selectedPkg.Name</h3>
                        <span class="badge" style="background-color: rgba(99, 102, 241, 0.1); color: var(--primary-purple);">ID: @selectedPkg.Id.ToString()[..8]</span>
                    </div>

                    <button class="btn text-white shadow-sm d-flex align-items-center px-4 py-2" @onclick="OpenUploadModal" style="background: linear-gradient(135deg, var(--primary-purple), #8b5cf6); border-radius: 8px; font-weight: 600;">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                        Upload Artifact
                    </button>
                </div>

                @if (!_versions.Any())
                {
                    <div class="text-center py-5 text-muted bg-light" style="border-radius: 12px; border: 1px dashed #cbd5e1;">
                        <p class="mb-0">No versions uploaded for this package yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted);">
                                <tr>
                                    <th>Version</th>
                                    <th>OS & Arch</th>
                                    <th>Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in _versions)
                                {
                                    <tr>
                                        <td class="fw-bold">@v.Version</td>
                                        <td>
                                            <span class="badge bg-light text-dark border me-1">@v.OperatingSystemFamily @v.OperatingSystemVersion</span>
                                            <span class="badge bg-secondary">@v.Architecture</span>
                                        </td>
                                        <td class="text-muted" style="font-size: 0.9rem;">@v.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" @onclick="() => HandleDeleteVersion(v.Id)">
                                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@* --- Modal: Create New Package --- *@
@if (_showNewPackageModal)
{
    <div class="modern-modal-overlay" @onclick="CloseModals">
        <div class="modern-modal-content" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold m-0 text-dark">Create New Package</h4>
                <button class="btn-close-custom" @onclick="CloseModals">✕</button>
            </div>

            <EditForm Model="@_newPackageModel" OnValidSubmit="HandleCreatePackage">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="modern-label">Software Name</label>
                    <InputText @bind-Value="_newPackageModel.Name" class="form-control glass-input" autocomplete="off" />
                    <ValidationMessage For="@(() => _newPackageModel.Name)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="mb-4">
                    <label class="modern-label">Description</label>
                    <InputText @bind-Value="_newPackageModel.Description" class="form-control glass-input" autocomplete="off" />
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn btn-link text-muted me-3 text-decoration-none fw-bold" @onclick="CloseModals">Cancel</button>
                    <button type="submit" class="btn text-white px-4 py-2" style="background-color: var(--primary-purple); border-radius: 8px; font-weight: 600;">
                        Create Package
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* --- Modal: Upload Artifact --- *@
@if (_showUploadModal)
{
    <div class="modern-modal-overlay" @onclick="CloseModals">
        <div class="modern-modal-content" @onclick:stopPropagation="true" style="max-width: 650px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold m-0 text-dark">Upload Package Version</h4>
                <button class="btn-close-custom" @onclick="CloseModals">✕</button>
            </div>

            <div class="alert mb-4" style="background-color: rgba(99, 102, 241, 0.05); border: 1px dashed rgba(99, 102, 241, 0.3); border-radius: 10px; color: var(--text-muted); font-size: 0.9rem;">
                Target Software: <strong style="color: var(--primary-purple);">@(_packages.FirstOrDefault(p => p.Id == _selectedPackageId)?.Name)</strong>
            </div>

            <EditForm Model="@_uploadModel" OnValidSubmit="HandleUploadArtifact">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Version</label>
                        <InputText @bind-Value="_uploadModel.Version" class="form-control glass-input" placeholder="e.g. 24.0.5" />
                        <ValidationMessage For="@(() => _uploadModel.Version)" class="text-danger mt-1 small fw-bold" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Architecture</label>
                        <InputSelect @bind-Value="_uploadModel.Architecture" class="form-select glass-input">
                            <option value="">Select...</option>
                            @foreach (var arch in Enum.GetValues<CpuArchitecture>())
                            {
                                <option value="@arch">@arch.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _uploadModel.Architecture)" class="text-danger mt-1 small fw-bold" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="modern-label">OS Family</label>
                        <InputSelect @bind-Value="_uploadModel.OperatingSystemFamily" class="form-select glass-input">
                            <option value="">Select...</option>
                            @foreach (var os in Enum.GetValues<OperatingSystemFamily>())
                            {
                                <option value="@os">@os.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _uploadModel.OperatingSystemFamily)" class="text-danger mt-1 small fw-bold" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="modern-label">OS Version</label>
                        <InputText @bind-Value="_uploadModel.OperatingSystemVersion" class="form-control glass-input" placeholder="e.g. 22.04" />
                        <ValidationMessage For="@(() => _uploadModel.OperatingSystemVersion)" class="text-danger mt-1 small fw-bold" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="modern-label">Format</label>
                        <InputSelect @bind-Value="_uploadModel.PackageType" class="form-select glass-input">
                            <option value="">Select...</option>
                            @foreach (var type in Enum.GetValues<PackageType>())
                            {
                                <option value="@type">@type.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _uploadModel.PackageType)" class="text-danger mt-1 small fw-bold" />
                    </div>
                </div>

                <div class="mb-4 mt-2">
                    <label class="modern-label">Artifact File</label>
                    <div class="file-upload-wrapper">
                        <InputFile OnChange="OnFileChange" class="form-control glass-input file-input-custom" />
                    </div>
                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="text-danger mt-1 small fw-bold">@_uploadError</div>
                    }
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn btn-link text-muted me-3 text-decoration-none fw-bold" @onclick="CloseModals">Cancel</button>
                    <button type="submit" class="btn text-white px-4 py-2 d-flex align-items-center" style="background-color: var(--primary-purple); border-radius: 8px; font-weight: 600;" disabled="@_isUploading">
                        @if (_isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
                            <span>Upload Artifact</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .package-list-item {
        border: none;
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.25rem;
        transition: all 0.2s ease;
    }

        .package-list-item:last-child {
            border-bottom: none;
        }

        .package-list-item:hover {
            background-color: rgba(99, 102, 241, 0.05);
        }

    .active-pkg {
        background-color: rgba(99, 102, 241, 0.1) !important;
        border-left: 4px solid var(--primary-purple) !important;
        color: var(--primary-purple) !important;
    }
</style>

@code {
    private bool _isLoadingPackages = true;
    private bool _isLoadingVersions;
    private List<PackageDto> _packages = new();
    private List<PackageVersionDto> _versions = new();
    private Guid? _selectedPackageId;
    private bool _showNewPackageModal;
    private bool _showUploadModal;
    private bool _isUploading;
    private string? _uploadError;
    private string? _pageError;
    private IBrowserFile? _selectedFile;
    private CreatePackageFormModel _newPackageModel = new();
    private UploadArtifactFormModel _uploadModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPackagesAsync();
    }

    private async Task LoadPackagesAsync()
    {
        _isLoadingPackages = true;
        _pageError = null;
        StateHasChanged();

        try
        {
            _packages = await PackageService.GetAllPackagesAsync();

            if (_selectedPackageId.HasValue && !_packages.Any(p => p.Id == _selectedPackageId.Value))
            {
                _selectedPackageId = null;
                _versions.Clear();
            }
        }
        catch (Exception ex)
        {
            _pageError = "Failed to load packages: " + ex.Message;
            _packages = new List<PackageDto>();
        }
        finally
        {
            _isLoadingPackages = false;
            StateHasChanged();
        }
    }

    private async Task SelectPackage(PackageDto pkg)
    {
        if (_selectedPackageId == pkg.Id) return;

        _selectedPackageId = pkg.Id;
        await LoadPackageVersionsAsync(pkg.Id);
    }

    private async Task LoadPackageVersionsAsync(Guid packageId)
    {
        _isLoadingVersions = true;
        _pageError = null;
        _versions.Clear();
        StateHasChanged();

        try
        {
            _versions = await PackageService.GetPackageVersionsAsync(packageId);
        }
        catch (Exception ex)
        {
            _pageError = "Failed to load versions: " + ex.Message;
            _versions = new List<PackageVersionDto>();
        }
        finally
        {
            _isLoadingVersions = false;
            StateHasChanged();
        }
    }

    private void OpenNewPackageModal()
    {
        _showNewPackageModal = true;
        StateHasChanged();
    }

    private void OpenUploadModal()
    {
        _uploadModel = new UploadArtifactFormModel();
        _selectedFile = null;
        _uploadError = null;
        _showUploadModal = true;
        StateHasChanged();
    }

    private void CloseModals()
    {
        _showNewPackageModal = false;
        _showUploadModal = false;
        StateHasChanged();
    }

    private async Task HandleCreatePackage()
    {
        try
        {
            await PackageService.CreatePackageAsync(_newPackageModel);
            CloseModals();
            await LoadPackagesAsync();
            _newPackageModel = new CreatePackageFormModel();
        }
        catch (Exception ex)
        {
            _pageError = "Failed to create package: " + ex.Message;
        }
    }

    private async Task HandleDeletePackage(Guid packageId)
    {
        try
        {
            await PackageService.DeletePackageAsync(packageId);
            await LoadPackagesAsync();
        }
        catch (Exception ex)
        {
            _pageError = "Failed to delete package: " + ex.Message;
        }
    }

    private void OnFileChange(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadError = null;
        StateHasChanged();
    }

    private async Task HandleUploadArtifact()
    {
        if (_selectedFile == null)
        {
            _uploadError = "Please select an artifact file to upload.";
            return;
        }

        if (!_selectedPackageId.HasValue) return;

        _isUploading = true;
        StateHasChanged();

        try
        {
            var maxAllowedSize = 500L * 1024 * 1024;
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize);
            var contentType = string.IsNullOrWhiteSpace(_selectedFile.ContentType)
                ? "application/octet-stream"
                : _selectedFile.ContentType;

            await PackageService.UploadVersionAsync(
                _selectedPackageId.Value,
                _uploadModel,
                stream,
                _selectedFile.Name,
                contentType);

            CloseModals();
            await LoadPackageVersionsAsync(_selectedPackageId.Value);
        }
        catch (Exception ex)
        {
            _uploadError = "Upload failed: " + ex.Message;
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteVersion(Guid versionId)
    {
        try
        {
            await PackageService.DeleteVersionAsync(versionId);
            if (_selectedPackageId.HasValue)
            {
                await LoadPackageVersionsAsync(_selectedPackageId.Value);
            }
        }
        catch (Exception ex)
        {
            _pageError = "Failed to delete version: " + ex.Message;
        }
    }
}