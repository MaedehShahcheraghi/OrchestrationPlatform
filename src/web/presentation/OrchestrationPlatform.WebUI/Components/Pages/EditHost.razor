@page "/hosts/edit/{Id:guid}"
@using OrchestrationPlatform.WebUI.Enums
@using OrchestrationPlatform.WebUI.Models.Hosts
@using OrchestrationPlatform.WebUI.Services.Hosts
@rendermode @(new InteractiveServerRenderMode(false))
@inject NavigationManager NavManager
@inject IHostHttpService HostService

<PageTitle>Edit Host - Orchestra</PageTitle>

<div class="page-header mb-5">
    <h1 class="page-title">Edit Node Configuration</h1>
    <p class="page-subtitle">Update connection details and status for your managed Linux target</p>
</div>

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
        <div class="spinner-border text-primary" style="color: var(--primary-purple) !important;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="custom-card shadow-sm border-0 position-relative" style="max-width: 900px; border-radius: 16px; overflow: hidden;">
        <div style="height: 6px; background: linear-gradient(90deg, #3b82f6, var(--primary-purple)); width: 100%; position: absolute; top: 0; left: 0;"></div>

        <div class="p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="d-flex align-items-center m-0" style="color: var(--text-main); font-weight: 700;">
                    <svg class="me-2 text-primary" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    Host Details
                </h4>
                <span class="badge" style="background-color: rgba(99, 102, 241, 0.1); color: var(--primary-purple); font-family: monospace; font-size: 0.85rem;">ID: @Id.ToString()[..8]</span>
            </div>

            @if (!string.IsNullOrEmpty(_pageError))
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    @_pageError
                    <button type="button" class="btn-close" @onclick="() => _pageError = null"></button>
                </div>
            }

            <EditForm Model="@_formModel" OnValidSubmit="HandleValidSubmit" FormName="UpdateHostForm">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="modern-label">
                        <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                        Host Identifier
                    </label>
                    <InputText @bind-Value="_formModel.Name" class="form-control glass-input" autocomplete="off" />
                    <ValidationMessage For="@(() => _formModel.Name)" class="text-danger mt-1 small fw-bold" />
                </div>

                <div class="row">
                    <div class="col-md-7 mb-4">
                        <label class="modern-label">
                            <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                            IPv4 Address
                        </label>
                        <InputText @bind-Value="_formModel.IpAddress" class="form-control glass-input" autocomplete="off" />
                        <ValidationMessage For="@(() => _formModel.IpAddress)" class="text-danger mt-1 small fw-bold" />
                    </div>

                    <div class="col-md-5 mb-4">
                        <label class="modern-label">
                            <svg class="me-2 text-secondary" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                            SSH User
                        </label>
                        <InputText @bind-Value="_formModel.Username" class="form-control glass-input" autocomplete="off" />
                        <ValidationMessage For="@(() => _formModel.Username)" class="text-danger mt-1 small fw-bold" />
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-3 mb-4">
                        <label class="modern-label">SSH Port</label>
                        <InputNumber @bind-Value="_formModel.SshPort" class="form-control glass-input" />
                        <ValidationMessage For="@(() => _formModel.SshPort)" class="text-danger mt-1 small fw-bold" />
                    </div>

                    <div class="col-md-3 mb-4">
                        <label class="modern-label">OS Family</label>
                        <InputSelect @bind-Value="_formModel.OperatingSystemFamily" class="form-select glass-input">
                            <option value="">-- Select --</option>
                            @foreach (var os in Enum.GetValues<OperatingSystemFamily>())
                            {
                                <option value="@os">@os.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _formModel.OperatingSystemFamily)" class="text-danger mt-1 small fw-bold" />
                    </div>

                    <div class="col-md-3 mb-4">
                        <label class="modern-label">OS Version</label>
                        <InputText @bind-Value="_formModel.OperatingSystemVersion" class="form-control glass-input" />
                        <ValidationMessage For="@(() => _formModel.OperatingSystemVersion)" class="text-danger mt-1 small fw-bold" />
                    </div>

                    <div class="col-md-3 mb-4">
                        <label class="modern-label">Architecture</label>
                        <InputSelect @bind-Value="_formModel.Architecture" class="form-select glass-input">
                            <option value="">-- Select --</option>
                            @foreach (var arch in Enum.GetValues<CpuArchitecture>())
                            {
                                <option value="@arch">@arch.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _formModel.Architecture)" class="text-danger mt-1 small fw-bold" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="modern-label">Description (Optional)</label>
                    <InputTextArea @bind-Value="_formModel.Description" class="form-control glass-input" rows="2" />
                </div>

                <div class="mb-5 p-3" style="background-color: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <div class="form-check form-switch d-flex align-items-center" style="padding-left: 0;">
                        <div class="flex-grow-1">
                            <label class="form-check-label fw-bold mb-1" style="color: var(--text-main); display: block;">Host Status</label>
                            <small class="text-muted">If deactivated, no new software can be deployed to this host.</small>
                        </div>
                        <InputCheckbox @bind-Value="_formModel.IsActive" class="form-check-input custom-switch" role="switch" style="width: 3em; height: 1.5em; cursor: pointer; margin-left: 1rem;" />
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center mt-4">
                    <a href="/hosts" class="btn btn-link text-muted me-4 text-decoration-none fw-bold">Cancel</a>

                    <button type="submit" class="btn text-white px-4 py-2 d-flex align-items-center" style="background-color: var(--primary-purple); border-radius: 10px; font-weight: 600; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); transition: all 0.3s;" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .glass-input {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 0.85rem 1.25rem;
        border-radius: 10px;
        font-size: 0.95rem;
        color: var(--text-main);
        transition: all 0.2s ease-in-out;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
    }

        .glass-input:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

    .modern-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        font-weight: 700;
    }

    .custom-switch:checked {
        background-color: var(--primary-purple) !important;
        border-color: var(--primary-purple) !important;
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private UpdateHostFormModel _formModel = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _pageError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var host = await HostService.GetHostByIdAsync(Id);

            if (host != null)
            {
                _formModel = new UpdateHostFormModel
                    {
                        Id = host.Id,
                        Name = host.Name,
                        IpAddress = host.IpAddress,
                        SshPort = host.SshPort,
                        Username = host.Username,
                        OperatingSystemFamily = host.OperatingSystemFamily,
                        OperatingSystemVersion = host.OperatingSystemVersion,
                        Architecture = host.Architecture,
                        Description = host.Description,
                        IsActive = host.IsActive
                    };
            }
            else
            {
                NavManager.NavigateTo("/hosts");
            }
        }
        catch (Exception)
        {
            NavManager.NavigateTo("/hosts");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        _pageError = null;
        StateHasChanged();

        try
        {
            await HostService.UpdateHostAsync(_formModel);
            NavManager.NavigateTo("/hosts");
        }
        catch (Exception ex)
        {
            _pageError = "Failed to update host: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}