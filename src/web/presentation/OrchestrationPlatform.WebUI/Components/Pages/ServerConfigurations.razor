@page "/configurations"
@using Microsoft.AspNetCore.SignalR.Client
@using OrchestrationPlatform.WebUI.DTOs.Operations
@using OrchestrationPlatform.WebUI.DTOs.Hosts
@using OrchestrationPlatform.WebUI.Services.Operations
@using OrchestrationPlatform.Domain.Enums
@using OrchestrationPlatform.WebUI.Services.Hosts
@rendermode @(new InteractiveServerRenderMode(false))
@implements IAsyncDisposable
@inject IConfiguration Config
@inject IOperationHttpService OperationService
@inject IHostHttpService HostService

<PageTitle>Server Configuration - Orchestra</PageTitle>

<div class="page-header mb-4">
    <h1 class="page-title">Infrastructure Configuration</h1>
    <p class="page-subtitle">Manage firewall rules and system services across multiple nodes</p>
</div>

@if (!string.IsNullOrEmpty(_pageMessage))
{
    <div class="alert alert-@_messageType alert-dismissible fade show mb-4 shadow-sm" style="border-radius: 12px;">
        @_pageMessage
        <button type="button" class="btn-close" @onclick="() => _pageMessage = null"></button>
    </div>
}

<div class="row">
    <div class="col-md-5 mb-4">
        <div class="custom-card shadow-sm h-100 p-0" style="border-radius: 16px; overflow: hidden;">
            <div class="p-3 d-flex justify-content-between align-items-center" style="background-color: #f8fafc; border-bottom: 1px solid var(--border-color);">
                <h6 class="m-0 fw-bold d-flex align-items-center" style="color: var(--text-main);">
                    <svg class="me-2 text-primary" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
                    Target Nodes
                </h6>
                <span class="badge bg-primary rounded-pill">@_selectedHostIds.Count Selected</span>
            </div>

            <div class="p-3 border-bottom position-relative">
                <svg class="position-absolute" style="left: 24px; top: 24px; color: #94a3b8;" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" class="form-control glass-input" style="padding-left: 36px;" placeholder="Search by name or IP..." @bind="_searchTerm" @bind:event="oninput" />
            </div>

            @if (_isLoadingHosts)
            {
                <div class="text-center p-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush" style="height: 350px; overflow-y: auto;">
                    @if (!PaginatedHosts.Any())
                    {
                        <div class="text-center py-4 text-muted">No hosts match your search.</div>
                    }
                    @foreach (var host in PaginatedHosts)
                    {
                        <label class="list-group-item list-group-item-action d-flex align-items-center" style="cursor: pointer; border-bottom: 1px solid var(--border-color);">
                            <input class="form-check-input me-3 mt-0 custom-checkbox" type="checkbox"
                                   checked="@_selectedHostIds.Contains(host.Id)"
                                   @onchange="@(e => ToggleHostSelection(host.Id, e.Value))">
                            <div>
                                <div class="fw-bold">@host.Name</div>
                                <div class="text-muted small" style="font-family: monospace;">@host.IpAddress</div>
                            </div>
                        </label>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center p-3" style="background-color: #f8fafc; border-top: 1px solid var(--border-color);">
                    <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" @onclick="PrevPage" disabled="@(_currentPage == 1)">← Prev</button>
                    <span class="text-muted small fw-bold">Page @_currentPage of @TotalPages</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" @onclick="NextPage" disabled="@(_currentPage >= TotalPages)">Next →</button>
                </div>
            }
        </div>
    </div>

    <div class="col-md-7 mb-4">
        <div class="custom-card shadow-sm h-100 p-4" style="border-radius: 16px;">
            <h5 class="fw-bold mb-4" style="color: var(--text-main);">Apply Configuration</h5>

            <div class="mb-4">
                <label class="modern-label">Configuration Category</label>
                <select class="form-select glass-input" @bind="_selectedCategory">
                    <option value="">-- Select Category --</option>
                    <option value="Firewall">Firewall Management (UFW)</option>
                    <option value="Service">System Services (Systemd)</option>
                </select>
            </div>

            @if (_selectedCategory == "Firewall")
            {
                <div class="row fade-in">
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Action</label>
                        <select class="form-select glass-input" @bind="_configFormModel.ConfigAction">
                            <option value="firewall_allow">Allow Port (Open)</option>
                            <option value="firewall_deny">Deny Port (Close)</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Port Number / Profile</label>
                        <input type="text" class="form-control glass-input" @bind="_configFormModel.ConfigValue" placeholder="e.g., 80, 443, or 'Nginx Full'" />
                    </div>
                </div>
            }
            else if (_selectedCategory == "Service")
            {
                <div class="row fade-in">
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Action</label>
                        <select class="form-select glass-input" @bind="_configFormModel.ConfigAction">
                            <option value="service_restart">Restart Service</option>
                            <option value="service_start">Start & Enable Service</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="modern-label">Service Name</label>
                        <input type="text" class="form-control glass-input" @bind="_configFormModel.ConfigValue" placeholder="e.g., nginx, docker, redis" />
                    </div>
                </div>
            }

            <div class="mt-5 d-flex justify-content-end border-top pt-4">
                <button class="btn text-white px-4 py-2 d-flex align-items-center shadow-sm"
                        style="background: linear-gradient(135deg, var(--primary-purple), #8b5cf6); border-radius: 8px; font-weight: 600;"
                        disabled="@(!CanExecute)"
                        @onclick="ExecuteConfiguration">

                    @if (_isExecuting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Deploying...</span>
                    }
                    else
                    {
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        <span>Execute on @_selectedHostIds.Count Nodes</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (_showLiveConsole)
{
    var totalProgress = _hostProgress.Any() ? (int)_hostProgress.Values.Average() : 0;
    <div class="custom-card shadow-lg mt-4 mb-5" style="border-radius: 16px; padding: 32px; background-color: #0f172a; border: 1px solid #1e293b;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold m-0 text-white d-flex align-items-center">
                <span class="spinner-grow spinner-grow-sm me-3 text-success" role="status"></span> Live Configuration Console
            </h5>
            <button type="button" class="btn-close btn-close-white" @onclick="() => _showLiveConsole = false"></button>
        </div>
        <div class="progress mb-4" style="height: 28px; border-radius: 12px; background-color: #1e293b;">
            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: @totalProgress%; background: linear-gradient(90deg, #8b5cf6, #3b82f6); font-weight: 800; font-size: 1rem;">
                @totalProgress%
            </div>
        </div>
        <div class="terminal-window p-3" style="background-color: #020617; border-radius: 12px; border: 1px solid #334155; height: 350px; overflow-y: auto; font-family: 'Consolas', monospace; font-size: 0.9rem;">
            @foreach (var log in _liveLogs)
            {
                <div class="mb-1" style="border-bottom: 1px dashed #1e293b; padding-bottom: 6px; margin-bottom: 6px;">
                    <span style="color: #64748b;">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                    <span style="color: #38bdf8; font-weight: bold;">[@(_operationToHostNameMap.TryGetValue(log.Payload.OperationId, out var name) ? name : log.Payload.OperationId.ToString()[..8])]</span>
                    <span class="@(log.Payload.Status.Contains("Fail") ? "text-danger fw-bold ms-1" : log.Payload.Status.Contains("Success") ? "text-success fw-bold ms-1" : "text-warning ms-1")">[@log.Payload.Status]</span>
                    <span class="ms-2 text-light">@log.Payload.Message</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _isLoadingHosts = true;
    private bool _isExecuting = false;
    private string? _pageMessage;
    private string _messageType = "success";
    private string _selectedCategory = "";

    private class ConfigFormModel
    {
        public string ConfigAction { get; set; } = "firewall_allow";
        public string ConfigValue { get; set; } = string.Empty;
    }

    private ConfigFormModel _configFormModel = new();
    private List<HostDto> _allHosts = new();
    private HashSet<Guid> _selectedHostIds = new();

    private string _searchTerm = string.Empty;
    private readonly int _pageSize = 6;
    private int _currentPage = 1;

    private HubConnection? _hubConnection;
    private bool _showLiveConsole;
    private readonly List<OperationLogEntry> _liveLogs = new();
    private readonly Dictionary<Guid, int> _hostProgress = new();
    private readonly List<Guid> _activeOperationIds = new();
    private readonly Dictionary<Guid, string> _operationToHostNameMap = new();

    public class OperationUpdatePayload
    {
        public Guid OperationId { get; set; }
        public string Status { get; set; } = string.Empty;
        public int Progress { get; set; }
        public string Message { get; set; } = string.Empty;
    }
    public record OperationLogEntry(DateTime Timestamp, OperationUpdatePayload Payload);

    private IEnumerable<HostDto> FilteredHosts => _allHosts
        .Where(h => string.IsNullOrWhiteSpace(_searchTerm) ||
                    h.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    h.IpAddress.Contains(_searchTerm));

    private IEnumerable<HostDto> PaginatedHosts => FilteredHosts.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredHosts.Count() / _pageSize));

    private bool CanExecute =>
        _selectedHostIds.Any() &&
        !string.IsNullOrWhiteSpace(_selectedCategory) &&
        !string.IsNullOrWhiteSpace(_configFormModel.ConfigAction) &&
        !string.IsNullOrWhiteSpace(_configFormModel.ConfigValue) &&
        !_isExecuting;

    protected override async Task OnInitializedAsync()
    {
        await LoadHostsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var baseUrl = Config.GetValue<string>("ApiSettings:BaseUrl") ?? "http://localhost:5232/";
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(baseUrl.TrimEnd('/') + "/hubs/operation")
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<OperationUpdatePayload>("ReceiveOperationUpdate", payload =>
            {
                _liveLogs.Insert(0, new OperationLogEntry(DateTime.Now, payload));
                _hostProgress[payload.OperationId] = payload.Progress;
                InvokeAsync(StateHasChanged);
            });
            await _hubConnection.StartAsync();
        }
    }

    private async Task LoadHostsAsync()
    {
        try
        {
            _isLoadingHosts = true;
            _allHosts = await HostService.GetAllHostsAsync();
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to load hosts: {ex.Message}", "danger");
        }
        finally
        {
            _isLoadingHosts = false;
        }
    }

    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }
    private void PrevPage() { if (_currentPage > 1) _currentPage--; }

    private void ToggleHostSelection(Guid hostId, object? isChecked)
    {
        if (isChecked is bool check && check)
            _selectedHostIds.Add(hostId);
        else
            _selectedHostIds.Remove(hostId);
    }

    private async Task ExecuteConfiguration()
    {
        try
        {
            _isExecuting = true;
            _pageMessage = null;

            _showLiveConsole = true;
            _liveLogs.Clear();
            _hostProgress.Clear();
            _activeOperationIds.Clear();
            _operationToHostNameMap.Clear();

            var operationType = _selectedCategory == "Firewall"
                ? OrchestrationOperationType.ConfigureFirewall
                : OrchestrationOperationType.ManageService;

            var dto = new ConfigureOperationDto(
                _selectedHostIds.ToList(),
                operationType,
                _configFormModel.ConfigAction,
                _configFormModel.ConfigValue
            );

            var result = await OperationService.TriggerConfigureAsync(dto);

            if (result.Any())
            {
                ShowMessage($"Configuration task dispatched successfully to {result.Count} nodes.", "success");

                if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
                {
                    foreach (var kvp in result)
                    {
                        var opId = kvp.Key;
                        var hostId = kvp.Value;
                        _operationToHostNameMap[opId] = _allHosts.FirstOrDefault(h => h.Id == hostId)?.Name ?? "Unknown Node";
                        _hostProgress[opId] = 0;
                        _activeOperationIds.Add(opId);
                        await _hubConnection.SendAsync("JoinOperationGroup", opId.ToString());
                    }
                }

                _selectedHostIds.Clear();
                _configFormModel = new ConfigFormModel();
                _selectedCategory = "";
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Failed to dispatch configuration: {ex.Message}", "danger");
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void ShowMessage(string message, string type)
    {
        _pageMessage = message;
        _messageType = type;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            foreach (var opId in _activeOperationIds)
            {
                try { await _hubConnection.SendAsync("LeaveOperationGroup", opId.ToString()); } catch { }
            }
            await _hubConnection.DisposeAsync();
        }
    }
}